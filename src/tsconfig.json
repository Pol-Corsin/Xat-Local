{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "bundler",
        "rootDir": ".",
        "outDir": "../dist",
        "sourceMap": true,
        "inlineSources": true,
        "noEmitOnError": true,
        "noImplicitAny": true,
        "strict": true,
        "allowJs": false,
        "removeComments": true
    },
    "include": [ // permet transpilar els types a global.d.ts
        "**/*.ts",
        "**/*.d.ts"
    ]
}